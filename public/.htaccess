# Deployed to /public_html/portfolio and served at / by the web root
# .htaccess (webroot/.htaccess), which rewrites every request in here.
DirectoryIndex index.html

# Real 404s for unknown URLs (no soft-404 fallback to the home page)
ErrorDocument 404 /portfolio/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Old /portfolio/ links → clean URLs. THE_REQUEST is the browser's original
  # request line, so the internal rewrite from / never matches this rule.
  RewriteCond %{THE_REQUEST} \s/portfolio(?:/(\S*))?\s
  RewriteRule ^ https://300consulting.fi/%1 [R=301,L,NE]
</IfModule>

# Cache static Next.js assets aggressively (they use content hashes)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json font/woff2
</IfModule>
