# Prefer index.html over index.php (overrides WordPress default)
DirectoryIndex index.html index.htm index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS + apex host (catches requests landing directly on /portfolio*)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.300consulting\.fi$ [NC]
  RewriteRule ^(.*)$ https://300consulting.fi/portfolio/$1 [R=301,L]

  # Serve real files and directories directly (static assets, fonts, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback: send everything else to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Cache static Next.js assets aggressively (they use content hashes)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json font/woff2
</IfModule>
